<Window x:Class="DxTools.App.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:DxTools.App.Properties"
        Title="{x:Static props:Strings.HotkeyCaptureTitle}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">
  <Border Margin="20"
          Padding="20"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <StackPanel>
      <TextBlock Text="{x:Static props:Strings.HotkeyCaptureTitle}"
                 FontSize="18"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="HintText" Text="{x:Static props:Strings.HotkeyCaptureSequenceHint}"
                 Style="{StaticResource HintStyle}"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0" />
      <TextBlock x:Name="GestureText"
                 FontSize="22"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center"
                 Margin="0,18,0,0" />
      <TextBlock x:Name="StepCountText"
                 Style="{StaticResource HintStyle}"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,0" />
      <TextBlock x:Name="ErrorText"
                 Foreground="{DynamicResource WarningBrush}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0"
                 Visibility="Collapsed" />
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,18,0,0">
        <Button Content="{x:Static props:Strings.HotkeyCaptureFinish}"
                Click="Finish_Click"
                Margin="0,0,8,0" />
        <Button Content="{x:Static props:Strings.Cancel}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="Cancel_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
