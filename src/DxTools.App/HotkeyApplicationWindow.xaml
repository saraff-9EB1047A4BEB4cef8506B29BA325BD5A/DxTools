<Window x:Class="DxTools.App.HotkeyApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:DxTools.App.Properties"
        Title="{x:Static props:Strings.HotkeyApplicationTitle}"
        Width="520"
        Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Border Margin="20"
          Padding="20"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Text="{x:Static props:Strings.HotkeyApplicationTitle}"
                 FontSize="18"
                 FontWeight="SemiBold" />
      <TextBlock Grid.Row="1"
                 Text="{x:Static props:Strings.HotkeyApplicationHint}"
                 Style="{StaticResource HintStyle}"
                 TextWrapping="Wrap"
                 Margin="0,8,0,10" />

      <Grid Grid.Row="2" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ProcessText"
                 Grid.Column="0"
                 VerticalContentAlignment="Center" />
        <Button Grid.Column="1"
                Content="{x:Static props:Strings.HotkeyApplicationCurrent}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="UseActiveWindow_Click"
                Margin="8,0,0,0" />
      </Grid>

      <ListBox x:Name="ProcessList"
               Grid.Row="3"
               SelectionChanged="ProcessList_SelectionChanged" />

      <TextBlock x:Name="ErrorText"
                 Grid.Row="4"
                 Foreground="{DynamicResource WarningBrush}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0"
                 Visibility="Collapsed" />

      <StackPanel Grid.Row="5"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0">
        <Button Content="{x:Static props:Strings.HotkeyApplicationAny}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="AnyApplication_Click" />
        <Button Content="{x:Static props:Strings.Cancel}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="Cancel_Click"
                Margin="8,0,0,0" />
        <Button Content="OK"
                Click="Ok_Click"
                Margin="8,0,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
