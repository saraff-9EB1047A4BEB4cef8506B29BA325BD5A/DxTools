<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DxTools.App</RootNamespace>
    <AssemblyName>DxTools</AssemblyName>
    <ApplicationIcon>Resources\DxTools.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DxTools.Core\DxTools.Core.csproj" />
    <ProjectReference Include="..\DxTools.Engine\DxTools.Engine.csproj" />
    <ProjectReference Include="..\DxTools.Interop\DxTools.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\DxTools.ico" />
  </ItemGroup>

</Project>
