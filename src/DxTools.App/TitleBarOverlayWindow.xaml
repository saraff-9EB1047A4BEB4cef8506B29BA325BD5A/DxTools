<Window x:Class="DxTools.App.TitleBarOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:DxTools.App.Properties"
        Width="92"
        Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <SolidColorBrush x:Key="TitleBarGlyphBrush" Color="#000000" />

    <Style x:Key="TitleBarCaptionButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TitleBarGlyphBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#00FF00" />
                <Setter Property="Foreground" Value="#000000" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#00C400" />
                <Setter Property="Foreground" Value="#000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Orientation="Horizontal" Background="Transparent">
    <Button Content="&#xE72A;"
            Style="{StaticResource TitleBarCaptionButtonStyle}"
            ToolTip="{x:Static props:Strings.TitleBarMoveNext}"
            AutomationProperties.Name="{x:Static props:Strings.TitleBarMoveNext}"
            Click="Move_Click" />
    <Button Content="&#xE718;"
            Style="{StaticResource TitleBarCaptionButtonStyle}"
            ToolTip="{x:Static props:Strings.TitleBarTopmost}"
            AutomationProperties.Name="{x:Static props:Strings.TitleBarTopmost}"
            Click="Topmost_Click" />
  </StackPanel>
</Window>
