<Window x:Class="DxTools.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:props="clr-namespace:DxTools.App.Properties"
        mc:Ignorable="d"
        Title="{x:Static props:Strings.AppTitle}"
        Icon="Resources/DxTools.ico"
        Width="940"
        Height="720"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Style="{StaticResource CardStyle}"
            Background="{DynamicResource HeroBrush}"
            Padding="20"
            Margin="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="56"
                Height="56"
                CornerRadius="14"
                Background="{DynamicResource AccentBrush}">
          <TextBlock Text="Dx"
                     Foreground="White"
                     FontSize="24"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{x:Static props:Strings.AppTitle}"
                     FontSize="24"
                     FontWeight="Bold" />
          <TextBlock Text="{x:Static props:Strings.AppSubtitle}"
                     Style="{StaticResource HintStyle}"
                     FontSize="13"
                     Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Border Style="{StaticResource PillStyle}"
                  Background="{DynamicResource AccentSoftBrush}"
                  HorizontalAlignment="Right">
            <TextBlock Text="{x:Static props:Strings.PhaseLabel}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="{Binding VersionText}"
                     Style="{StaticResource HintStyle}"
                     Margin="0,6,0,0"
                     HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="0,16,0,8">
      <TabItem Header="{x:Static props:Strings.GeneralTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,4,0">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <CheckBox Content="{x:Static props:Strings.StartWithWindows}"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                <TextBlock Text="{x:Static props:Strings.StartWithWindowsHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="26,2,0,0" />

                <CheckBox Content="{x:Static props:Strings.StartMinimized}"
                          IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                          Margin="0,14,0,2" />
                <TextBlock Text="{x:Static props:Strings.StartMinimizedHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="26,2,0,0" />

                <CheckBox Content="{x:Static props:Strings.EnableSecondaryTaskbar}"
                          IsChecked="{Binding EnableSecondaryTaskbar, Mode=TwoWay}"
                          Margin="0,14,0,2" />
                <TextBlock Text="{x:Static props:Strings.EnableSecondaryTaskbarHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="26,2,0,0" />

                <CheckBox Content="{x:Static props:Strings.TaskbarAutoHide}"
                          IsChecked="{Binding TaskbarAutoHide, Mode=TwoWay}"
                          Margin="0,12,0,2" />
                <TextBlock Text="{x:Static props:Strings.TaskbarAutoHideHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="26,2,0,0" />

                <CheckBox Content="{x:Static props:Strings.TitleBarButtons}"
                          IsChecked="{Binding EnableTitleBarButtons, Mode=TwoWay}"
                          Margin="0,12,0,2" />
                <TextBlock Text="{x:Static props:Strings.TitleBarButtonsHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="26,2,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{x:Static props:Strings.PinnedAppsTitle}"
                             Style="{StaticResource SectionTitleStyle}"
                             Margin="0" />
                  <Button Content="{x:Static props:Strings.AddPinnedApp}"
                          Command="{Binding AddPinnedAppCommand}"
                          DockPanel.Dock="Right"
                          Style="{StaticResource SecondaryButtonStyle}"
                          HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="{x:Static props:Strings.PinnedAppsHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,8,0,8" />
                <TextBlock Text="{x:Static props:Strings.NoPinnedApps}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PinnedApps.Count}" Value="0">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding PinnedApps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceAltBrush}"
                              CornerRadius="8"
                              Padding="10"
                              Margin="0,4,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PathText}" Style="{StaticResource HintStyle}" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Content="{x:Static props:Strings.Delete}"
                                  Command="{Binding RemoveCommand}"
                                  Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.Language}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.LanguageHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                  <RadioButton Content="{x:Static props:Strings.LanguageAuto}"
                               GroupName="Language"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Language, Converter={StaticResource EnumToBoolean}, ConverterParameter=Auto, Mode=TwoWay}" />
                  <RadioButton Content="{x:Static props:Strings.LanguageRussian}"
                               GroupName="Language"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Language, Converter={StaticResource EnumToBoolean}, ConverterParameter=Russian, Mode=TwoWay}" />
                  <RadioButton Content="{x:Static props:Strings.LanguageEnglish}"
                               GroupName="Language"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Language, Converter={StaticResource EnumToBoolean}, ConverterParameter=English, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Text="{x:Static props:Strings.RestartRequired}"
                           Foreground="{DynamicResource WarningBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.Theme}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.ThemeHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                  <RadioButton Content="{x:Static props:Strings.ThemeSystem}"
                               GroupName="Theme"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=System, Mode=TwoWay}" />
                  <RadioButton Content="{x:Static props:Strings.ThemeLight}"
                               GroupName="Theme"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=Light, Mode=TwoWay}" />
                  <RadioButton Content="{x:Static props:Strings.ThemeDark}"
                               GroupName="Theme"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=Dark, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.BackupTitle}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.BackupHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="{x:Static props:Strings.ExportBackup}"
                          Command="{Binding ExportBackupCommand}"
                          Margin="0,0,8,0" />
                  <Button Content="{x:Static props:Strings.ImportBackup}"
                          Command="{Binding ImportBackupCommand}"
                          Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{Binding BackupStatusMessage}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static props:Strings.MonitorsTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,4,0">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{x:Static props:Strings.CurrentLayout}"
                             Style="{StaticResource SectionTitleStyle}"
                             Margin="0" />
                  <Button Content="{x:Static props:Strings.RefreshMonitors}"
                          DockPanel.Dock="Right"
                          Command="{Binding Display.RefreshCommand}"
                          Style="{StaticResource SecondaryButtonStyle}"
                          HorizontalAlignment="Right" />
                </DockPanel>

                <TextBlock Style="{StaticResource HintStyle}" Margin="0,8,0,6">
                  <Run Text="{x:Static props:Strings.Topology}" />
                  <Run Text=": " />
                  <Run Text="{Binding Display.TopologyHash, Mode=OneWay}" />
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Display.Monitors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceAltBrush}"
                              CornerRadius="8"
                              Padding="12"
                              Margin="0,5,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GeometryText}" Style="{StaticResource HintStyle}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding DpiText}" Style="{StaticResource HintStyle}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding RefreshText}" Style="{StaticResource HintStyle}" HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.SplitsTitle}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.SplitsHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{x:Static props:Strings.SplitRows}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <TextBox Text="{Binding SplitRows, UpdateSourceTrigger=LostFocus}"
                           Width="60" />
                  <TextBlock Text="{x:Static props:Strings.SplitColumns}"
                             VerticalAlignment="Center"
                             Margin="16,0,8,0" />
                  <TextBox Text="{Binding SplitColumns, UpdateSourceTrigger=LostFocus}"
                           Width="60" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.SaveCurrentProfile}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBox Text="{Binding Display.NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,4" />
                <TextBlock Text="{x:Static props:Strings.ProfileNameHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,10" />
                <CheckBox Content="{x:Static props:Strings.AutoApply}"
                          IsChecked="{Binding Display.NewProfileAutoApply, Mode=TwoWay}" />
                <Button Content="{x:Static props:Strings.SaveCurrentProfile}"
                        Command="{Binding Display.SaveProfileCommand}"
                        Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.Profiles}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.NoProfiles}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Display.HasProfiles}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Display.Profiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceAltBrush}"
                              CornerRadius="8"
                              Padding="12"
                              Margin="0,6,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MonitorSummary}" Style="{StaticResource HintStyle}" />
                            <TextBlock Text="{Binding CreatedText}" Style="{StaticResource HintStyle}" />
                          </StackPanel>
                          <CheckBox Grid.Column="1"
                                    Content="{x:Static props:Strings.AutoApply}"
                                    IsChecked="{Binding AutoApply, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="12,0" />
                          <Button Grid.Column="2"
                                  Content="{x:Static props:Strings.Apply}"
                                  Command="{Binding DataContext.Display.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Profile}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="0,0,8,0" />
                          <Button Grid.Column="3"
                                  Content="{x:Static props:Strings.Delete}"
                                  Command="{Binding DataContext.Display.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Profile}"
                                  Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding Display.StatusMessage}"
                       Style="{StaticResource HintStyle}"
                       Margin="2,0,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static props:Strings.WindowsTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,4,0">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{x:Static props:Strings.CurrentWindows}"
                             Style="{StaticResource SectionTitleStyle}"
                             Margin="0" />
                  <Button Content="{x:Static props:Strings.RefreshMonitors}"
                          DockPanel.Dock="Right"
                          Command="{Binding WindowProfiles.RefreshCommand}"
                          Style="{StaticResource SecondaryButtonStyle}"
                          HorizontalAlignment="Right" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding WindowProfiles.Windows}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceAltBrush}"
                              CornerRadius="8"
                              Padding="12"
                              Margin="0,5,0,0">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Style="{StaticResource HintStyle}">
                            <Run Text="{Binding ProcessName, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding MonitorLabel, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding GeometryText, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.SaveWindowProfile}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBox Text="{Binding WindowProfiles.NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,4" />
                <TextBlock Text="{x:Static props:Strings.WindowProfileNameHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,10" />
                <Button Content="{x:Static props:Strings.SaveWindowProfile}"
                        Command="{Binding WindowProfiles.SaveProfileCommand}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.WindowProfiles}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.NoWindowProfiles}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowProfiles.HasProfiles}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding WindowProfiles.Profiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceAltBrush}"
                              CornerRadius="8"
                              Padding="12"
                              Margin="0,6,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource HintStyle}" />
                            <TextBlock Text="{Binding CreatedText}" Style="{StaticResource HintStyle}" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Content="{x:Static props:Strings.Apply}"
                                  Command="{Binding DataContext.WindowProfiles.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Profile}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="0,0,8,0" />
                          <Button Grid.Column="2"
                                  Content="{x:Static props:Strings.Delete}"
                                  Command="{Binding DataContext.WindowProfiles.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Profile}"
                                  Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding WindowProfiles.StatusMessage}"
                       Style="{StaticResource HintStyle}"
                       Margin="2,0,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static props:Strings.HotkeysTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,4,0">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.HotkeysTab}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.HotkeyHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Hotkeys}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceAltBrush}"
                              CornerRadius="8"
                              Padding="12"
                              Margin="0,5,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding DisplayGesture}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Description}"
                                     Margin="12,0"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" FontSize="12">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                                <Setter Property="Text" Value="{x:Static props:Strings.HotkeyInactive}" />
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Registered}" Value="True">
                                    <Setter Property="Text" Value="{x:Static props:Strings.HotkeyActive}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <Button Grid.Column="3"
                                  Content="{x:Static props:Strings.HotkeyChange}"
                                  Command="{Binding DataContext.ChangeHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="8,0,0,0" />
                          <Button Grid.Column="4"
                                  Content="{x:Static props:Strings.HotkeyPrefix}"
                                  Command="{Binding DataContext.ChangeHotkeyPrefixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="6,0,0,0" />
                          <Button Grid.Column="5"
                                  Content="{x:Static props:Strings.HotkeyClearPrefix}"
                                  Command="{Binding DataContext.ClearHotkeyPrefixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="6,0,0,0" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static props:Strings.WallpaperTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,4,0">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{x:Static props:Strings.WallpaperTitle}"
                             Style="{StaticResource SectionTitleStyle}"
                             Margin="0" />
                  <Button Content="{x:Static props:Strings.RefreshMonitors}"
                          DockPanel.Dock="Right"
                          Command="{Binding Wallpaper.RefreshCommand}"
                          Style="{StaticResource SecondaryButtonStyle}"
                          HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="{x:Static props:Strings.WallpaperHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,8,0,10" />

                <ItemsControl ItemsSource="{Binding Wallpaper.Monitors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceAltBrush}"
                              CornerRadius="8"
                              Padding="12"
                              Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GeometryText}" Style="{StaticResource HintStyle}" />
                            <TextBlock Text="{Binding ImageDisplay}" Style="{StaticResource HintStyle}" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Content="{x:Static props:Strings.ChooseImage}"
                                  Command="{Binding BrowseCommand}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="8,0" />
                          <Button Grid.Column="2"
                                  Content="{x:Static props:Strings.ClearImage}"
                                  Command="{Binding ClearCommand}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  IsEnabled="{Binding HasImage}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.WallpaperFit}"
                           Style="{StaticResource SectionTitleStyle}" />
                <WrapPanel>
                  <RadioButton Content="{x:Static props:Strings.FitFill}"
                               GroupName="WallpaperFit"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Wallpaper.FitMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Fill, Mode=TwoWay}" />
                  <RadioButton Content="{x:Static props:Strings.FitFit}"
                               GroupName="WallpaperFit"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Wallpaper.FitMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Fit, Mode=TwoWay}" />
                  <RadioButton Content="{x:Static props:Strings.FitStretch}"
                               GroupName="WallpaperFit"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Wallpaper.FitMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Stretch, Mode=TwoWay}" />
                  <RadioButton Content="{x:Static props:Strings.FitCenter}"
                               GroupName="WallpaperFit"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Wallpaper.FitMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Center, Mode=TwoWay}" />
                  <RadioButton Content="{x:Static props:Strings.FitTile}"
                               GroupName="WallpaperFit"
                               Style="{StaticResource SegmentRadioStyle}"
                               IsChecked="{Binding Wallpaper.FitMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Tile, Mode=TwoWay}" />
                </WrapPanel>

                <Button Content="{x:Static props:Strings.ApplyWallpaper}"
                        Command="{Binding Wallpaper.ApplyCommand}"
                        Margin="0,14,0,0" />
                <TextBlock Text="{x:Static props:Strings.WallpaperNote}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,10,0,0" />
                <TextBlock Text="{Binding Wallpaper.StatusMessage}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,6,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.SlideshowTitle}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.SlideshowHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding Wallpaper.SlideshowFolderDisplay}"
                           Style="{StaticResource ValueStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <Button Content="{x:Static props:Strings.ChooseFolder}"
                        Command="{Binding Wallpaper.ChooseSlideshowFolderCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="{x:Static props:Strings.SlideshowInterval}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <TextBox Text="{Binding Wallpaper.SlideshowIntervalSeconds, UpdateSourceTrigger=LostFocus}"
                           Width="80" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="{x:Static props:Strings.StartSlideshow}"
                          Command="{Binding Wallpaper.StartSlideshowCommand}"
                          Margin="0,0,8,0" />
                  <Button Content="{x:Static props:Strings.Stop}"
                          Command="{Binding Wallpaper.StopSlideshowCommand}"
                          IsEnabled="{Binding Wallpaper.IsSlideshowRunning}"
                          Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static props:Strings.TriggersTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,4,0">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{x:Static props:Strings.TriggersTab}"
                             Style="{StaticResource SectionTitleStyle}"
                             Margin="0" />
                  <Button Content="{x:Static props:Strings.TriggerAdd}"
                          Command="{Binding Triggers.AddCommand}"
                          DockPanel.Dock="Right"
                          Style="{StaticResource SecondaryButtonStyle}"
                          HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="{x:Static props:Strings.TriggerHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,8,0,8" />
                <TextBlock Text="{x:Static props:Strings.NoTriggers}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Triggers.HasTriggers}" Value="False">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Triggers.Triggers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceAltBrush}"
                              CornerRadius="8"
                              Padding="12"
                              Margin="0,6,0,0">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Grid.Column="1"
                                      Content="{x:Static props:Strings.TriggerEnabled}"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      Margin="12,0" />
                            <Button Grid.Column="2"
                                    Content="{x:Static props:Strings.Delete}"
                                    Command="{Binding DeleteCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                          </Grid>

                          <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="140" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static props:Strings.TriggerEvent}"
                                       Style="{StaticResource HintStyle}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Events}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Event, Mode=TwoWay}" />
                          </Grid>

                          <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="140" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static props:Strings.TriggerAction}"
                                       Style="{StaticResource HintStyle}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Actions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Action, Mode=TwoWay}" />
                          </Grid>

                          <TextBlock Text="{x:Static props:Strings.TriggerCondition}"
                                     Style="{StaticResource HintStyle}"
                                     Margin="0,8,0,2" />
                          <TextBox Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" />

                          <TextBlock Text="{x:Static props:Strings.TriggerParameter}"
                                     Style="{StaticResource HintStyle}"
                                     Margin="0,8,0,2" />
                          <TextBox Text="{Binding Parameter, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.TriggerScriptsTitle}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.TriggerScriptsHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding Triggers.ScriptsDirectory}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,8" />
                <Button Content="{x:Static props:Strings.OpenScriptsFolder}"
                        Command="{Binding Triggers.OpenScriptsFolderCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding Triggers.StatusMessage}"
                       Style="{StaticResource HintStyle}"
                       Margin="2,0,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{x:Static props:Strings.DiagnosticsTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,4,0">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{x:Static props:Strings.NativeStatus}"
                             Style="{StaticResource SectionTitleStyle}"
                             Margin="0,0,10,0" />
                  <Border HorizontalAlignment="Left" Margin="0,0,0,8">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource PillStyle}">
                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding SafeMode}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding NativeStatusText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </Border>
                </StackPanel>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static props:Strings.Status}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static props:Strings.ApiVersion}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ApiVersionText}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static props:Strings.LibraryVersion}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LibraryVersionText}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static props:Strings.Ping}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PingText}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static props:Strings.NativePath}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NativePath}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static props:Strings.CheckedAt}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CheckedAtText}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />
                </Grid>

                <Button Content="{x:Static props:Strings.SelfCheck}"
                        Command="{Binding SelfCheckCommand}"
                        Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.LogsTitle}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static props:Strings.LogsHint}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding LogDirectory}"
                           Style="{StaticResource ValueStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,12" />
                <Button Content="{x:Static props:Strings.OpenLogs}"
                        Command="{Binding OpenLogsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static props:Strings.AboutTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,4,0">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{x:Static props:Strings.AboutTitle}"
                           Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static props:Strings.Version}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static props:Strings.License}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseText}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static props:Strings.Repository}" Style="{StaticResource HintStyle}" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RepositoryUrl}" Style="{StaticResource ValueStyle}" Margin="0,0,0,6" />
                </Grid>
                <TextBlock Text="{Binding CopyrightText}"
                           Style="{StaticResource HintStyle}"
                           Margin="0,8,0,0" />
                <Button Content="{x:Static props:Strings.OpenRepository}"
                        Command="{Binding OpenRepositoryCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,14,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <TextBlock Text="{Binding PhaseNote}"
                         Style="{StaticResource HintStyle}"
                         FontSize="13" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="2,2,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource HintStyle}"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Text="{x:Static props:Strings.CloseToTray}"
                 Style="{StaticResource HintStyle}"
                 Margin="16,0,0,0"
                 VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
