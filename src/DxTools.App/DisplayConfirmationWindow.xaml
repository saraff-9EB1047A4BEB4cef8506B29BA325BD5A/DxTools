<Window x:Class="DxTools.App.DisplayConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:DxTools.App.Properties"
        Title="{x:Static props:Strings.DisplayApplyConfirmTitle}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Border Margin="20"
          Padding="20"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <StackPanel>
      <TextBlock Text="{x:Static props:Strings.DisplayApplyConfirmTitle}"
                 FontSize="18"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="MessageText"
                 Style="{StaticResource HintStyle}"
                 FontSize="13"
                 Margin="0,10,0,0" />
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,18,0,0">
        <Button Content="{x:Static props:Strings.Revert}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="Revert_Click"
                Margin="0,0,8,0" />
        <Button Content="{x:Static props:Strings.Keep}"
                Click="Keep_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
