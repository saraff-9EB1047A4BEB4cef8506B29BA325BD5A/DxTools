<Window x:Class="DxTools.App.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:DxTools.App.Properties"
        Title="{x:Static props:Strings.AppTitle}"
        Width="800"
        Height="48"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseWheel="OnPreviewMouseWheel">
  <Border BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,1,0,0"
          Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="6,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="DxButton"
              Content="Dx"
              Style="{StaticResource TaskbarStartButtonStyle}"
              ToolTip="{x:Static props:Strings.TaskbarDxMenu}"
              AutomationProperties.Name="{x:Static props:Strings.TaskbarDxMenu}"
              Focusable="False"
              Click="OnDxButtonClick" />

      <ScrollViewer x:Name="WindowScroller"
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    PanningMode="HorizontalOnly">
        <ItemsControl ItemsSource="{Binding Windows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      ToolTip="{Binding ToolTipText}"
                      AutomationProperties.Name="{Binding DisplayTitle}"
                       Focusable="False"
                       MouseEnter="OnWindowButtonMouseEnter"
                       MouseLeave="OnWindowButtonMouseLeave"
                       PreviewMouseRightButtonUp="OnWindowButtonPreviewMouseRightButtonUp">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource TaskbarButtonStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <Image Source="{Binding Icon}"
                         Width="18"
                         Height="18"
                         Margin="0,0,7,0" />
                  <TextBlock Text="{Binding DisplayTitle}"
                             MaxWidth="150"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Button x:Name="TrayButton"
              Grid.Column="2"
              Content="▾"
              Width="32"
              Height="30"
              Padding="0"
              FontSize="14"
              Style="{StaticResource SecondaryButtonStyle}"
              ToolTip="{x:Static props:Strings.TrayButton}"
              Command="{Binding ToggleTrayCommand}"
              Focusable="False"
              Margin="0,0,4,0" />

      <TextBlock Grid.Column="3"
                 Text="{Binding ClockText}"
                 FontSize="13"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 TextAlignment="Right"
                 MinWidth="52"
                 Margin="10,0,6,0" />


      <Popup x:Name="TrayPopup"
             PlacementTarget="{Binding ElementName=TrayButton}"
             Placement="Top"
             IsOpen="{Binding IsTrayOpen, Mode=TwoWay}"
             StaysOpen="False"
             AllowsTransparency="True"
             VerticalOffset="-8">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                Width="380"
                MaxHeight="420">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TrayItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="36"
                          Height="34"
                          Padding="0"
                          Margin="2"
                          Style="{StaticResource SecondaryButtonStyle}"
                          Command="{Binding ClickCommand}"
                          ToolTip="{Binding Name}"
                          PreviewMouseRightButtonUp="OnTrayButtonPreviewMouseRightButtonUp">
                    <Image Source="{Binding Icon}" Width="22" Height="22" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
