<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Package</OutputType>
    <OutputName>DxTools-$(ProductVersion)-x64</OutputName>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.16.0</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Package.wxs" />
    <Compile Include="GeneratedComponents.wxs" />
  </ItemGroup>

</Project>
